{
  "name": "pixel-world",
  "version": "1.0.0",
  "description": "Carte du monde multijoueur en pixel art (Node.js + Socket.io + générateur Python)",
  "main": "server/index.js",
  "scripts": {
    "generate-map": "python3 map-generator/generate_map.py --seed 42",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "setup": "npm run generate-map && npm install"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
